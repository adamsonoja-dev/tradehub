# Candleflow environment variables
# Copy to .env and fill in your own values.

# Server port (optional, defaults to 8000)
PORT=8000

# Session signing secret (generate a long random value, e.g. openssl rand -hex 32)
CANDLEFLOW_SESSION_SECRET=

# External API keys
EXCHANGE_RATE_API_KEY=
TWELVE_DATA_API_KEY=
FREE_CRYPTO_API_KEY=

# Admin account (created/seeded on startup)
CANDLEFLOW_ADMIN_EMAIL=admin@candleflow.io
CANDLEFLOW_ADMIN_PASSWORD=

# Supabase (project URL + service role key from Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=